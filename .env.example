# 模拟模式不会调用API，仅识别 examples/demo 下明确标记的演示行。
CIRP_PROVIDER=mock
CIRP_LIVE_API_ENABLED=false
CIRP_API_BASE_URL=https://api.deepseek.com
CIRP_API_KEY=
CIRP_CHEAP_MODEL=deepseek-v4-flash
# 每百万token的人民币价格；必须按你实际使用的API确认。未确认禁止付费。
CIRP_PRICES_CONFIRMED=false
CIRP_INPUT_CNY_PER_MILLION=0
CIRP_OUTPUT_CNY_PER_MILLION=0
# 数据默认存放 .local/；不要纳入Git。预算累计保存在该目录数据库中，不要删除以重置预算。
# CIRP_DATA_DIR=/your/local/path

# 远程预览由scripts/remote_preview.py自动生成随机密码，下面默认不启用。
CIRP_REMOTE_ENABLED=false
CIRP_PREVIEW_USER=engineer
CIRP_PREVIEW_PASSWORD=
CIRP_ORIGIN_TOKEN=
CIRP_ALLOWED_HOSTS=localhost,127.0.0.1
