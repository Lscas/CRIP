# 模拟模式不会调用API，仅识别 examples/demo 下明确标记的演示行。
CIRP_PROVIDER=mock
CIRP_LIVE_API_ENABLED=false
CIRP_API_BASE_URL=https://api.deepseek.com
CIRP_API_KEY=
CIRP_CHEAP_MODEL=deepseek-v4-flash
CIRP_VISION_ENABLED=false
CIRP_VISION_MODEL=deepseek-v4-flash-vision-exp
# 每百万token的人民币价格；必须按你实际使用的API确认。未确认禁止付费。
CIRP_PRICES_CONFIRMED=false
CIRP_INPUT_CNY_PER_MILLION=0
CIRP_OUTPUT_CNY_PER_MILLION=0
# 有界请求包络；输入是保守UTF-8字节估算，不是实际token计数。
CIRP_INPUT_LIMIT_BYTES=32000
CIRP_OUTPUT_LIMIT_TOKENS=8000
# DeepSeek V4 Flash 请优先运行 start-deepseek-live.ps1 或 scripts/deepseek_local_setup.py。
# 用户选择保存时，密钥只进入Windows DPAPI当前用户加密文件；不要把密钥写入本文件。
# Google Gemini 3.6 Flash 可改用下列值；同样优先运行 start-gemini-live.ps1：
# CIRP_PROVIDER=gemini
# CIRP_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CIRP_CHEAP_MODEL=gemini-3.6-flash
# 数据默认存放 .local/；不要纳入Git。预算累计保存在该目录数据库中，不要删除以重置预算。
# CIRP_DATA_DIR=/your/local/path

# 远程预览由scripts/remote_preview.py自动生成随机密码，下面默认不启用。
CIRP_REMOTE_ENABLED=false
CIRP_PREVIEW_USER=engineer
CIRP_PREVIEW_PASSWORD=
CIRP_ORIGIN_TOKEN=
CIRP_ALLOWED_HOSTS=localhost,127.0.0.1
