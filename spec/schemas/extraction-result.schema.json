{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cirp.invalid/schemas/0.2.0/extraction-result.schema.json",
  "title": "单次联合抽取结果",
  "type": "object",
  "properties": {
    "disposition": {
      "enum": [
        "CANDIDATES",
        "NO_REQUIREMENTS",
        "NEEDS_CONTEXT",
        "TRUNCATED"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "https://cirp.invalid/schemas/0.2.0/requirement.schema.json"
      },
      "minItems": 0
    },
    "reason": {
      "type": "string",
      "maxLength": 400
    }
  },
  "required": [
    "disposition",
    "requirements",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "NO_REQUIREMENTS"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "maxItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "CANDIDATES"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
