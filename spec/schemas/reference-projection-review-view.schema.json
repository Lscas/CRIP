{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cirp.invalid/schemas/0.2.6/reference-projection-review-view.schema.json",
  "title": "Dynamically authenticated original-source review view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "view_version",
    "result_id",
    "result_hash",
    "result_kind",
    "run_id",
    "snapshot_id",
    "question",
    "projection_execution_version",
    "loop_version",
    "status",
    "selections",
    "object_condition_relations_verified",
    "answer_completeness_verified",
    "review_view_sha256"
  ],
  "properties": {
    "view_version": {
      "const": "reference-projection-review-view-1"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "result_hash": {
      "$ref": "#/$defs/hash"
    },
    "result_kind": {
      "const": "PROJECTION_LOOP_OUTCOME"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "projection_execution_version": {
      "const": "reference-projection-execution-2"
    },
    "loop_version": {
      "const": "project-projection-loop-2"
    },
    "status": {
      "const": "REVIEW_REQUIRED"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "document_id",
          "pdf_sha256",
          "page_number",
          "manifest_sha256",
          "projection_version",
          "source_row_ref",
          "row_text_sha256",
          "direction",
          "char_ids",
          "row_ref",
          "part_refs",
          "document_name",
          "text",
          "geometry"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "pdf_sha256": {
            "$ref": "#/$defs/hash"
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "manifest_sha256": {
            "$ref": "#/$defs/hash"
          },
          "projection_version": {
            "type": "string",
            "minLength": 1
          },
          "source_row_ref": {
            "type": "string",
            "minLength": 1
          },
          "row_text_sha256": {
            "$ref": "#/$defs/hash"
          },
          "direction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "degrees",
              "reading_axis",
              "line_axis"
            ],
            "properties": {
              "degrees": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              },
              "reading_axis": {
                "type": "string",
                "minLength": 1
              },
              "line_axis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "char_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "row_ref": {
            "type": "string",
            "pattern": "^X[1-9][0-9]*$"
          },
          "part_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P[1-9][0-9]*$"
            }
          },
          "document_name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coordinate_system",
              "page_width",
              "page_height",
              "rotation",
              "bbox",
              "render_crop_bbox",
              "render_mode"
            ],
            "properties": {
              "coordinate_system": {
                "const": "pdf-cropbox-points-top-left"
              },
              "page_width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "page_height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rotation": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              },
              "bbox": {
                "$ref": "#/$defs/box"
              },
              "render_crop_bbox": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/box"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "render_mode": {
                "enum": [
                  "SOURCE_CROP",
                  "FULL_PAGE"
                ]
              }
            }
          }
        }
      }
    },
    "object_condition_relations_verified": {
      "const": false
    },
    "answer_completeness_verified": {
      "const": false
    },
    "review_view_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "box": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    }
  }
}
