{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cirp.invalid/schemas/0.2.6/reference-projection-candidate.schema.json",
  "title": "Offline whole PDF projection row selection, always review-required",
  "type": "object",
  "properties": {
    "contract_version": {"const": "reference-projection-candidate-1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selections": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "row_ref": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
          "part_refs": {
            "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^P[1-9][0-9]*$"}
          }
        },
        "required": ["row_ref", "part_refs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contract_version", "manifest_sha256", "input_sha256", "selections"],
  "additionalProperties": false
}
