{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cirp.invalid/schemas/0.2.6/project-answer-v2.schema.json",
  "title": "Claim-bound QA V2 answer",
  "type": "object",
  "properties": {
    "status": {"enum": ["ANSWERED", "PARTIAL", "INSUFFICIENT"]},
    "answer": {"type": "string", "minLength": 1, "maxLength": 4000},
    "claims": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {"const": "TEXT"},
                    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 160},
                    "quote": {"type": "string", "minLength": 1, "maxLength": 1800}
                  },
                  "required": ["type", "evidence_id", "quote"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {"const": "IMAGE_REGION"},
                    "region_id": {"type": "string", "minLength": 1, "maxLength": 160},
                    "document_id": {"type": "string", "minLength": 1, "maxLength": 160},
                    "page_number": {"type": "integer", "minimum": 1},
                    "bbox": {
                      "type": "array", "minItems": 4, "maxItems": 4,
                      "items": {"type": "number"}
                    },
                    "observation": {"type": "string", "minLength": 1, "maxLength": 1000},
                    "needs_review": {"const": true}
                  },
                  "required": ["type", "region_id", "document_id", "page_number", "bbox", "observation", "needs_review"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["text", "citations"],
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "calculations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "operator": {"enum": ["ADD", "SUBTRACT", "MULTIPLY", "DIVIDE", "PERCENT_OF"]},
          "operands": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^-?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\\.[0-9]+)?$",
              "maxLength": 48
            }
          },
          "result": {
            "type": "string",
            "pattern": "^-?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\\.[0-9]+)?$",
            "maxLength": 48
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "type": {"const": "TEXT"},
                "evidence_id": {"type": "string", "minLength": 1, "maxLength": 160},
                "quote": {"type": "string", "minLength": 1, "maxLength": 1800}
              },
              "required": ["type", "evidence_id", "quote"],
              "additionalProperties": false
            }
          }
        },
        "required": ["operator", "operands", "result", "citations"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "answer", "claims", "missing", "calculations"],
  "additionalProperties": false
}
